<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GreyPost</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        
        <div class="flex justify-between items-center">
            <h5> Edit your Post</h5> 
            <a href="/logout" class="px-5 py-2 bg-red-500 text-sm rounded-md">Logout</a>
        </div>
        
          
        <form method="post" action="/update/<%= post._id %>">
                <textarea placeholder="what's on your mind" class=" block p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md" name="content"><%= post.content %></textarea>
                <input class="px-3 py-2 w-35 bg-yellow-500 block text-black text-sm rounded-md mt-2" type="submit" value="Update Post">
        </form>
    </div>
    
</body>
</html>