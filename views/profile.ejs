<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GreyPost</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
</head>
<body>
    <div class="w-full min-h-screen  bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-end">
            <a href="/logout" class="px-5 py-2 bg-red-500 text-sm rounded-md">Logout</a>
        </div>
        
        <div class="flex items-start gap-3" >
            <div class="w-10 h-10 rounded-md overflow-hidden">
                <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profilepic %>" alt="">
            </div>
            <div class="flex items-start gap-3 rounded-md">
                <h3 class="text-3xl"><span class="font-light">Hello</span>, <%= user.name %></h3>
                <div class="flex gap-5 mt-3">
                    <p>
                        <span class="font-bold"><%= user.followers.length %></span>
                        Followers
                    </p>

                    <p>
                        <span class="font-bold"><%= user.following.length %></span>
                        Following
                    </p>
                </div>
                <% if (user._id.toString() !== currentUser._id.toString()) { %>

                    <% if (currentUser.following.some(id => id.toString() === user._id.toString())) { %>

                        <a href="/unfollow/<%= user._id %>"
                            class="bg-gray-500 text-white px-4 py-2 rounded">
                            Unfollow
                        </a>

                    <% } else { %>

                        <a href="/follow/<%= user._id %>"
                            class="bg-blue-500 text-white px-4 py-2 rounded">
                            Follow
                        </a>

                    <% } %>

                <% } %>
            </div>
            
        </div>
        <div>
            <h5 class="mb-5 mt-3">you can create a post</h5>
           
            <form method="post" action="/post">
                 <textarea placeholder="what's on your mind" class=" block p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md" name="content"></textarea>
                <input class="px-3 py-2 w-35 bg-blue-500 block text-sm rounded-md mt-2" type="submit" value="create new post">
            </form>

            <div class="posts mt-10">
                <h3 class="text-zinc-400">your Post</h3>
                <div class="postcontainer mt-5">
                   <% user.posts.reverse().forEach(function(post){ %>
                    <div class="post w-1/3 rounded-md p-4 mb-2  border-[1px] border-zinc-800 bg-zinc-800">
                        <h4 class="text-blue-500 mb-2">@<%= user.username%></h4>
                        <p class="text-sm tracking-tight"><%= post.content %></p>
                        <small class="mt-2 inline-block text-red-400"> <%= post.likes.length %></small>
                        <div class="btns flex mt-1 flex justify-between">
                            <a class="text-pink-500" href="/like/<%= post._id %>">
                                <%= post.likes.indexOf(user._id) === -1  ? "Like" : "Unlike" %>
                            </a>
                            <a class="text-orange-500" href="/edit/<%= post._id %>">edit</a>
                        </div>
                    </div>

                <%   }) %>
                </div>
            </div>
            
        </div>
            
       
    </div>
    
</body>
</html>